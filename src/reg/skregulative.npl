scope main {

    norm n1: order(Id, Ag, Opt, D) & not assembledBaseSk(Id)
        -> obligation(Ag, true, assembledBaseSk(Id), D)
            if fulfilled: srs1(Ag, 10)
            if unfulfilled: srs2(Ag, 10)
        .

    norm n2: assembledBaseSk(Id) & order(Id, Ag, true, D)
        -> obligation(Ag, true, assembledOptionals(Id), D)
            if fulfilled: srs1(Ag, 5)
            if unfulfilled: srs2(Ag, 5)
        .

    sanction-rule srs1(Ag, X)
        -> sanction(Ag, increaseImage(X)).

    sanction-rule srs2(Ag, X)
        -> sanction(Ag, decreaseImage(X)).


}