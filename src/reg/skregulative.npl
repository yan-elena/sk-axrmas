scope main {

    norm n1: order(Id, Ag, D)
        -> obligation(Ag, n1, assembledSk(Id), D)
            if fulfilled: srs1(Ag)
            if unfulfilled: srs2(Ag)
        .

    sanction-rule srs1(Ag)
        -> sanction(Ag, increaseReputation(10)).

    sanction-rule srs2(Ag)
        -> sanction(Ag, decreaseReputation(10)).
}