scope main {

    norm n1: order(Id, Ag, Pref, D)
        -> obligation(Ag, n1, assembledBaseSk(Id), D)
            if fulfilled: srs1(Ag, 10)
            if unfulfilled: srs2(Ag, 10)
        .

    norm n2: assembledBaseSk(Id) & order(Id, Ag, optionals, D)
        -> obligation(Ag, n2, assembledOptionals(Id), D)
            if fulfilled: srs1(Ag, 5)
            if unfulfilled: srs2(Ag, 5)
        .

    sanction-rule srs1(Ag, X)
        -> sanction(Ag, increaseImage(X)).

    sanction-rule srs2(Ag, X)
        -> sanction(Ag, decreaseImage(X)).


    // process regulations todo

    // regulative norm for governing the realization of the detect reuglation sub-capability
    norm rnsp1: required(detect, [ordersQueue(R, A)]) & play(Ag, skController, skgroup)
        -> obligation(Ag, rnsp1, realized(detect, [ordersQueue(R, A), NId]), false)
        .

    // regulative norm for governing the realization of the design reuglation sub-capability
    norm rnsp2: required(design, [NId]) & play(Ag, skController, skgroup)
        -> obligation(Ag, rnsp2, realized(design, [NId, N2]), false)
        .

    // regulative norm for governing the realization of the execute reuglation sub-capability
    norm rnsp3: required(execute, [NId, N2, Op])  & play(Ag, skController, skgroup)
        -> obligation(Ag, rnsp2, realized(execute, [N2, Op]), false)
        .

}