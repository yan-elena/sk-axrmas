institution_id : sk_inst .

status_functions:
states: required(Cap, Args), realized(Cap, Args) .

constitutive_rules:

1: ordersQueue(R, A) count-as required(detect, [ordersQueue(R, A)]) .

2: bottleneck count-as realized(detect, [n2]) .

3: realized(detected, [NId]) count-as required(design, [NId]) .

4: designed(N2, Op) count-as realized(design, [NId, N2, Op]) while required(design, [NId]) .

5: realized(design, [NId, N2, Op]) count-as required(execute, [NId, N2, Op]) .

6: executed(Nid, N2, Op) count-as realized(execute, [N2, Op]) while required(execute, [NId, N2, Op]).