institution_id : sk_inst .

status_functions:
states: completed(Order) .

constitutive_rules:

1: assembledBaseSk(Id) count-as completed(order(Id, Ag, basic, D)) while order(Id, Ag, basic, D) .

2: assembledOptionals(Id) count-as completed(order(Id, Ag, optionals, D)) while order(Id, Ag, optionals, D) & assembledBaseSk(Id).
