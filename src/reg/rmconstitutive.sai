institution_id : sk_inst .

status_functions:
states: required(Cap, Args), realized(Cap, Args) .

constitutive_rules:

1: orderQueue(N) count-as required(detect, [bottleneck]) while N > 3 .

2: sk(detected(bottleneck)) count-as realized(detect, [bottleneck, nSai2]) .

3: realized(detect, [bottleneck, NId]) count-as required(design, [NId]) .

4: sk(designed(N2, Op)) count-as realized(design, [NId, N2, Op]) while required(design, [NId]) .

5: realized(design, [NId, N2, Op]) count-as required(execute, [NId, N2, Op]) .

6: sk(executed(NId, [N2, Op])) count-as realized(execute, [NId, N2, Op]) while required(execute, [NId, N2, Op]).
